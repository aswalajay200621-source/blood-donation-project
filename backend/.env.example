# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Self-hosted Hospital PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_blood_bank
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=hospital_blood_bank
# Set to true to use embedded storage when PostgreSQL is not yet running locally
USE_SQLITE_FALLBACK=true

# JWT Authentication Secrets
JWT_ACCESS_SECRET=hospital_blood_bank_super_secret_jwt_access_token_key_2026!#$
JWT_REFRESH_SECRET=hospital_blood_bank_super_secret_jwt_refresh_token_key_2026!#$
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# 2FA Settings
TWO_FACTOR_APP_NAME=HospitalBloodBank

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@hospital.med
DEFAULT_ADMIN_PASSWORD=admin123

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Email Integration (Nodemailer - Standby by default)
EMAIL_ENABLED=false
SMTP_HOST=smtp.hospital.med
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=donations@hospital.med
SMTP_PASS=hospital_smtp_password_here
EMAIL_FROM="Apex Hospital Blood Center" <donations@hospital.med>

# WhatsApp Integration (Abstracted Provider: mock | meta_cloud | twilio | gupshup)
WHATSAPP_PROVIDER=mock
WHATSAPP_ENABLED=true
WHATSAPP_API_KEY=mock_api_key_or_access_token
WHATSAPP_PHONE_NUMBER_ID=109283746592817
WHATSAPP_TEMPLATE_3MONTH=donor_eligibility_reminder_v1
WHATSAPP_TEMPLATE_THANKYOU=donor_appreciation_receipt_v1
